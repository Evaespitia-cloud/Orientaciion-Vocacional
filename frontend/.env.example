# ============================================================
# ORIENTACIÓN VOCACIONAL — Variables de entorno (Frontend)
# ============================================================
# Copia este archivo como .env en frontend/ y ajusta los valores.
# NO subas el archivo .env real al repositorio.

# ── Conexión con el backend ──────────────────────────────────
# URL base de la API del backend (sin barra final)
BACKEND_API_URL=http://localhost:5000/api

# ── Seguridad ────────────────────────────────────────────────
# Clave secreta de Flask para sesiones (debe ser diferente a la del backend)
SECRET_KEY=usa-una-clave-frontend-aleatoria-de-al-menos-32-caracteres

# ── Entorno ──────────────────────────────────────────────────
# development | production
FLASK_ENV=development
FLASK_DEBUG=1

MAX_CONTENT_LENGTH=2097152
