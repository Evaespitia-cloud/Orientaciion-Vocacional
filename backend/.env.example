# ============================================================
# ORIENTACIÓN VOCACIONAL — Variables de entorno (Backend)
# ============================================================
# Copia este archivo como .env en backend/ y ajusta los valores
# según tu entorno.  NO subas el archivo .env real al repositorio.

# ── Base de datos ────────────────────────────────────────────
# Cadena de conexión PostgreSQL
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD
DATABASE_URL=postgresql://postgres:tupassword@localhost:5432/orientacion

# ── Seguridad ────────────────────────────────────────────────
# Clave secreta de Flask (usa un valor aleatorio largo en producción)
SECRET_KEY=usa-una-clave-aleatoria-de-al-menos-32-caracteres

# Clave secreta para firmar los tokens JWT
JWT_SECRET_KEY=usa-otra-clave-aleatoria-de-al-menos-32-caracteres

# ── Entorno ──────────────────────────────────────────────────
# development | production
FLASK_ENV=development
FLASK_DEBUG=1

ALLOWED_ORIGINS=http://localhost:5001
MAX_CONTENT_LENGTH=2097152
